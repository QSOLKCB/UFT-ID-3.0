  "design_rules": [
    "The compact U=(S,A,F,Pi_lex,O,T,I,C) notation remains a summary, not a license to overload distinct mechanism types.",
    "Every invariant names domain/codomain, transformation, hypotheses, predicate/property, break conditions, kind, scope, status, claim class, lineage and nonclaims.",
    "Assurance dimensions are independent typed records. No transitive promotion is inferred merely because nodes are connected.",
    "A named mathematical object must satisfy its type-specific minimum declaration before it may appear in a theorem premise.",
    "A scientific hypothesis that claims falsifiability must name perturbation/control variables, observables, predictions, null behavior, rejection conditions, evidence requirements and scope.",
    "Private author-supplied papers may motivate generic design patterns but are not published as source-byte authority."
  ],
  "hard_rules": {
    "claim_label_implies_implemented_structure": false,
    "claimed_reversibility_without_inverse_or_bijectivity_evidence": false,
    "content_identity_implies_semantic_truth": false,
    "deterministic_replay_implies_scientific_confirmation": false,
    "falsifiable_claim_may_omit_rejection_condition": false,
    "formal_proof_implies_runtime_conformance": false,
    "implemented_pattern_implies_universal_theorem": false,
    "named_object_implies_well_defined_object": false,
    "paper_specific_ontology_is_inherited_by_methodological_reuse": false,
    "private_attachment_identifier_may_be_published": false,
    "proxy_may_silently_replace_source_object": false,
    "runtime_conformance_implies_empirical_validation": false
  },
